{"type":"FeatureCollection","features":[{"type":"Feature","id":"coyote-deity","properties":{"id":"coyote-deity","name":"Coyote","mythologyId":"native-american","type":"trickster","era":"ancient","eraBucket":"ancient","description":"The great trickster of Native American mythology. Both wise and foolish, creator and destroyer. Stole fire for humanity.","imageUrl":"https://upload.wikimedia.org/wikipedia/commons/thumb/1/13/Mesa_Verde_National_Park_Cliff_Palace_2006_09_12.jpg/1280px-Mesa_Verde_National_Park_Cliff_Palace_2006_09_12.jpg","domains":"trickster,creation,fire,chaos","color":"#8D6E63"},"geometry":{"type":"Point","coordinates":[-115.14,36.17]}},{"type":"Feature","id":"raven-deity","properties":{"id":"raven-deity","name":"Raven","mythologyId":"native-american","type":"trickster","era":"ancient","eraBucket":"ancient","description":"Trickster creator of the Pacific Northwest. Stole light from the Sky Chief. Shape-shifter. Both cosmic creator and mischievous fool.","imageUrl":"https://upload.wikimedia.org/wikipedia/commons/thumb/1/13/Mesa_Verde_National_Park_Cliff_Palace_2006_09_12.jpg/1280px-Mesa_Verde_National_Park_Cliff_Palace_2006_09_12.jpg","domains":"trickster,light,creation,transformation","color":"#8D6E63"},"geometry":{"type":"Point","coordinates":[-134.42,58.3]}},{"type":"Feature","id":"white-buffalo-deity","properties":{"id":"white-buffalo-deity","name":"White Buffalo Calf Woman","mythologyId":"native-american","type":"spirit","era":"ancient","eraBucket":"ancient","description":"Sacred figure who brought the chanunpa (sacred pipe) and seven sacred rites to the Lakota people. Transformed into a white buffalo calf.","imageUrl":"https://upload.wikimedia.org/wikipedia/commons/thumb/1/13/Mesa_Verde_National_Park_Cliff_Palace_2006_09_12.jpg/1280px-Mesa_Verde_National_Park_Cliff_Palace_2006_09_12.jpg","domains":"sacred-gift,ceremony,prophecy","color":"#8D6E63"},"geometry":{"type":"Point","coordinates":[-102.34,43.88]}},{"type":"Feature","id":"spider-woman","properties":{"id":"spider-woman","name":"Spider Woman","mythologyId":"native-american","type":"spirit","era":"ancient","eraBucket":"ancient","description":"Creator and protector in Navajo, Hopi, and other traditions. Taught weaving. Guides heroes through the underworld. Weaves the web of life.","imageUrl":"https://upload.wikimedia.org/wikipedia/commons/thumb/1/13/Mesa_Verde_National_Park_Cliff_Palace_2006_09_12.jpg/1280px-Mesa_Verde_National_Park_Cliff_Palace_2006_09_12.jpg","domains":"creation,weaving,wisdom,protection","color":"#8D6E63"},"geometry":{"type":"Point","coordinates":[-109.62,36.17]}},{"type":"Feature","id":"sedna-deity","properties":{"id":"sedna-deity","name":"Sedna","mythologyId":"native-american","type":"goddess","era":"ancient","eraBucket":"ancient","description":"Inuit goddess of the sea. Rules all marine animals from the ocean floor. Shamans must comb her hair to release animals for hunting.","imageUrl":"https://upload.wikimedia.org/wikipedia/commons/thumb/1/13/Mesa_Verde_National_Park_Cliff_Palace_2006_09_12.jpg/1280px-Mesa_Verde_National_Park_Cliff_Palace_2006_09_12.jpg","domains":"sea,marine-animals,survival","color":"#8D6E63"},"geometry":{"type":"Point","coordinates":[-68.52,63.75]}}]}