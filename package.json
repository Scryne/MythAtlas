{
  "name": "mythatlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "qa:data-integrity": "node qa/data-integrity-check.mjs",
    "qa:content": "node qa/content-integrity-check.mjs && node scripts/build-public-data.mjs --check",
    "data:clean": "node scripts/clean-content.mjs && node scripts/build-public-data.mjs",
    "data:wiki-match": "node scripts/wiki-match.mjs",
    "qa:new-feature": "node qa/new-feature-audit.mjs",
    "qa:browser": "node qa/new-feature-browser-audit.mjs",
    "qa:full": "node qa/full-qa-audit.mjs",
    "qa:release": "npm run lint && npm run qa:data-integrity && npm run qa:content && npm run qa:new-feature && npm run build"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "framer-motion": "^11.0.0",
    "maplibre-gl": "^6.11.2",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "lighthouse": "^13.0.3",
    "playwright": "^1.58.2",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0"
  }
}
